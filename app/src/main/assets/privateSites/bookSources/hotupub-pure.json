  "searchUrl": "https://www.hotupub.net/book/search/{{java.encodeURI(key)}}",
  "exploreUrl": "全部::https://www.hotupub.net/book/?page={{page}}&rows=10&isvip=-1&cate=0&words=0&state=-1\n免费::https://www.hotupub.net/book/?page={{page}}&rows=10&isvip=0&cate=0&words=0&state=-1\n完结::https://www.hotupub.net/book/?page={{page}}&rows=10&isvip=-1&cate=0&words=0&state=9",
  "ruleSearch": {
    "bookList": "class.search-main-itembox@tag.li",
    "name": "class.search-bookinfo@tag.a.0@text",
    "author": "class.search-authname@text",
    "bookUrl": "tag.a.0@href",
    "coverUrl": "tag.img.0@src",
    "intro": "class.search-bookintro@text",
    "kind": "class.search-auth@tag.a.1@text",
    "lastChapter": "class.search-newupdate@text",
    "wordCount": "class.search-auth@tag.a.2@text"
  },
  "ruleExplore": {
    "bookList": "class.bookstack-ullist-itembox",
    "name": "class.bookstack-ullist-booktitle@text",
    "author": "class.bookstack-ullist-auicon@text",
    "bookUrl": "tag.a.0@href",
    "coverUrl": "tag.img.0@src",
    "intro": "class.bookstack-ulist-bookintro@text",
    "kind": "class.bookstack-ullist-bookabout@tag.a.0@text",
    "lastChapter": "class.bookstack-ullist-bookstate@text",
    "wordCount": "class.bookstack-ullist-bookabout@tag.a.2@text"
  },
  "ruleBookInfo": {
    "name": "tag.h1@text",
    "author": "class.bookdetalis-bookinfo-authname@text||class.bookdetalis-bookinfo-auicon@text",
    "intro": "class.bookdetalis-bookinfo-bookintro@text",
    "kind": "class.bookdetalis-bookinfo-someinfo@tag.a.0@text",
    "wordCount": "class.bookdetalis-bookinfo-someinfo@tag.a.2@text",
    "coverUrl": "class.bookdetalis-cover@tag.img@src||tag.img@src",
    "lastChapter": "class.bookdetails-cataloglist-item.-1@tag.a@title||class.bookdetails-cataloglist-item.-1@tag.a@text",
    "tocUrl": "@js:baseUrl"
  },
  "ruleToc": {
    "chapterList": "class.bookdetails-cataloglist-item",
    "chapterName": "tag.a@title||tag.a@text",
    "chapterUrl": "tag.a@href",
    "isVip": "@text##.*(?:訂購|订购|點數|点数|購買|购买).*"
  },
  "ruleContent": {
    "content": "class.bookread-content-box@html",
    "replaceRegex": "##(?:手机阅读|手機閱讀|掃碼前往|扫码前往|河圖文化.*(?:官方|地址)|河图文化.*(?:官方|地址)|请收藏本站|請收藏本站|本章完).*$"
  },
